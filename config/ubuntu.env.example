CAMPUS_OPS_DATA_DIR=/var/lib/campus-ops
CAMPUS_OPS_NO_BROWSER=1
CAMPUS_OPS_AUTONOMY_MODE=observe
CAMPUS_OPS_SYSLOG_BIND=127.0.0.1
CAMPUS_OPS_SYSLOG_PORT=5514
CAMPUS_OPS_SURICATA_EVE=/var/log/suricata/eve.json
CAMPUS_OPS_ZEEK_LOG_DIR=/opt/zeek/logs/current
# Optional trusted local JSONL exports; enable only readable deployed feeds.
# CAMPUS_OPS_TETRAGON_LOG=/var/log/campus-sensors/tetragon.jsonl
# CAMPUS_OPS_FALCO_LOG=/var/log/falco/events.jsonl
# CAMPUS_OPS_WAZUH_LOG=/var/ossec/logs/alerts/alerts.json
# CAMPUS_OPS_OPENCANARY_LOG=/var/log/opencanary/events.jsonl
# CAMPUS_OPS_HUBBLE_LOG=/var/log/campus-sensors/hubble.jsonl
# CAMPUS_OPS_RISK_POLICY=/etc/campus-ops/risk-policy.json

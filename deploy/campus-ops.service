[Unit]
Description=Campus Cyber Operations Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=campus-ops
Group=campus-ops
SupplementaryGroups=wireshark
StateDirectory=campus-ops
WorkingDirectory=/var/lib/campus-ops
Environment=HOME=/var/lib/campus-ops
Environment=CAMPUS_OPS_DATA_DIR=/var/lib/campus-ops
Environment=CAMPUS_OPS_NO_BROWSER=1
EnvironmentFile=-/etc/campus-ops/managed-feeds.env
EnvironmentFile=-/etc/campus-ops/sensors.env
EnvironmentFile=/etc/campus-ops/campus-ops.env
Environment=PATH=/opt/zeek/bin:/opt/campus-ops/opencanary/bin:/opt/campus-ops/analysis/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# The main process owns the live packet worker. Linux acquisition is performed by
# dumpcap/tcpdump children, so the service must carry the same narrowly scoped network
# capabilities already used by campus-ops-sensor@.service. File capabilities alone are
# not sufficient on every systemd/WSL/containerized Ubuntu environment because the
# service execution context can differ from an interactive/runuser verification.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

ExecStart=/opt/campus-ops/venv/bin/python -m campus_ops
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
